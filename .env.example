# ===========================================
# SUPABASE AUTHENTICATION
# ===========================================
# Lấy credentials từ: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# 
# 1. Đăng nhập Supabase Dashboard
# 2. Vào Project Settings > API
# 3. Copy URL và anon/public key vào đây

# URL của Supabase project
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Anonymous key (client-side)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ===========================================
# CÀI ĐẶT SUPABASE AUTH
# ===========================================
# 
# 1. Bật Email Auth:
#    - Vào Authentication > Providers > Email
#    - Enable Email provider
#    - Bật "Confirm email" nếu muốn user phải xác minh email
#
# 2. Cấu hình Email (tùy chọn):
#    - Vào Authentication > Email Templates
#    - Tùy chỉnh email xác minh và reset password
#    - Hoặc dùng SMTP settings mặc định của Supabase
#
# 3. Cấu hình Redirect URL:
#    - Vào Authentication > URL Configuration
#    - Thêm Site URL: http://localhost:5173 (dev)
#    - Thêm Redirect URLs: http://localhost:5173/reset-password
#
# ===========================================
# GEMINI API (Optional)
# ===========================================
GEMINI_API_KEY="your-gemini-api-key"

# ===========================================
# APP URL
# ===========================================
# URL của ứng dụng (dùng cho redirect trong email)
APP_URL="http://localhost:5173"
